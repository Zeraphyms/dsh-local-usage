node_modules/

# Local agent workspace: session scratch and notes, never part of the package.
.workbuddy/

# lib/ is intentionally NOT ignored: this plugin is distributed from git, and a
# checked-in build keeps installation independent of whether the installer runs
# dependency scripts (pnpm blocks them by default until approved).

# Promo film: a private production pipeline, not part of the plugin and never
# published. It stays on the machine that renders it; everything under here —
# pipeline sources and the hundreds of megabytes it renders alike — is local.
video/


# Local TTS runtime for the promo film (edge-tts); not part of the package.
.venv-tts/
